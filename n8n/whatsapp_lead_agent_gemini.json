      "id": "464cecbf-2119-4f8e-92bf-f0eeac3ce964",
      "name": "Config"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nconst body = cfg.body || {};\nconst base = {gemini_key: cfg.gemini_key, gemini_model: cfg.gemini_model, phone_number_id: cfg.phone_number_id, wa_token: cfg.wa_token, approval_mode: cfg.approval_mode, owner_chat_id: cfg.owner_chat_id};\nconst sd = $getWorkflowStaticData('global');\nsd.seen = sd.seen || [];\nconst out = [];\nfor (const entry of (body.entry || [])) {\n  for (const ch of (entry.changes || [])) {\n    const v = ch.value || {};\n    const names = {};\n    for (const c of (v.contacts || [])) names[c.wa_id] = (c.profile || {}).name || '';\n    for (const m of (v.messages || [])) {\n      if (sd.seen.includes(m.id)) continue;\n      sd.seen.push(m.id);\n      const text = m.type === 'text' ? m.text.body : '[' + m.type + ' message]';\n      out.push({json: {...base, sender_id: m.from, profile_name: names[m.from] || '', text}});\n    }\n  }\n}\nsd.seen = sd.seen.slice(-200);\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "id": "19dd9425-e63f-4592-9052-d92433bf1fd1",
      "name": "Parse Event"
    },
    {
      "parameters": {
        "jsCode": "const BIZ = {\n  name: 'YOUR BUSINESS NAME',\n  type: 'gym / clinic / salon / coaching class',\n  owner: 'OWNER NAME',\n  services: 'Service 1 - Rs ___; Service 2 - Rs ___',\n  timings: 'Mon-Sat 9am-8pm',\n  address: 'Your address / area',\n  booking_link: 'https://your-booking-link'\n};\nconst SYSTEM = `You are the WhatsApp assistant for ${BIZ.name}, a ${BIZ.type}. Owner: ${BIZ.owner}.\n\n# Language and tone\n- Reply in the customer's language (Hindi, Hinglish or English). Mirror them.\n- Friendly and short (2-4 lines), max 1-2 emojis. Sound like a helpful staff member, not a robot.\n\n# Business info (the only source of truth)\nServices and prices: ${BIZ.services}\nTimings: ${BIZ.timings}\nAddress: ${BIZ.address}\nBooking link: ${BIZ.booking_link}\n\n# Your job\n1. Answer questions using only the business info above. If the answer is not there, do not guess: escalate.\n2. Qualify the lead, one question at a time: what they need, budget, preferred day and time, area.\n3. When they are ready, share the booking link or say the owner will call them.\n4. Fill the \"lead\" fields as you learn them.\n\n# Never\n- No medical, legal or financial advice. No guaranteed results. No invented prices, offers or availability.\n- Do not pressure the customer.\n- For non-text messages (image, audio, location, document): politely ask them to type their question. If it looks like a complaint or payment proof, escalate.\n\n# Escalate (escalate=true) when\n- Complaint, refund, payment problem, or an angry customer\n- Any medical or emergency mention\n- The customer asks for the owner or a human\n- The information is not available above\n\n# Output: valid JSON only, nothing else\n{\"reply\": \"message to send\", \"escalate\": false, \"escalate_reason\": \"\", \"lead\": {\"name\": \"\", \"need\": \"\", \"budget\": \"\", \"preferred_time\": \"\", \"location\": \"\", \"interested\": false}}\nLeave unknown lead fields as empty strings.`;\nconst d = $input.first().json;\nconst sd = $getWorkflowStaticData('global');\nsd.history = sd.history || {};\nlet h = sd.history[d.sender_id] || [];\nh.push({role: 'user', content: d.text});\nh = h.slice(-14);\nwhile (h.length && h[0].role !== 'user') h.shift();\nsd.history[d.sender_id] = h;\nreturn [{json: {...d, gemini_body: {systemInstruction: {parts: [{text: SYSTEM}]}, contents: h.map(m => ({role: m.role === 'assistant' ? 'model' : 'user', parts: [{text: m.content}]})), generationConfig: {maxOutputTokens: 600, responseMimeType: 'application/json'}}}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "id": "db09c195-779c-472d-b00a-d2e18d363fac",
      "name": "Build Gemini Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $json.gemini_model }}:generateContent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.gemini_body) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $json.gemini_key }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "id": "2c7df627-507f-4701-ae2b-146f11542dbb",
      "name": "Gemini"
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Build Gemini Request').first().json;\nconst raw = (($input.first().json.candidates || [])[0]?.content?.parts?.[0]?.text) || '';\nlet data;\ntry { data = JSON.parse(raw.replace(/^```json|^```|```$/gm, '').trim()); }\ncatch (e) { data = {reply: '', escalate: true, escalate_reason: 'JSON parse error', lead: {}}; }\nconst sd = $getWorkflowStaticData('global');\nlet h = sd.history[ctx.sender_id] || [];\nh.push({role: 'assistant', content: raw});\nsd.history[ctx.sender_id] = h.slice(-14);\nsd.leads = sd.leads || {};\nsd.hot = sd.hot || {};\nconst merged = {...(sd.leads[ctx.sender_id] || {})};\nfor (const [k, v] of Object.entries(data.lead || {})) { if (v || k === 'interested') merged[k] = k === 'interested' ? (merged[k] || !!v) : v; }\nsd.leads[ctx.sender_id] = merged;\nconst save_lead = Object.entries(merged).some(([k, v]) => k !== 'interested' && v);\nconst hot = !!merged.interested && !sd.hot[ctx.sender_id];\nif (hot) sd.hot[ctx.sender_id] = true;\nreturn [{json: {...ctx, gemini_body: undefined,\n  reply: data.reply || 'Main aapka message owner ko forward kar raha hu, wo jald reply karenge.',\n  escalate: !!data.escalate, escalate_reason: data.escalate_reason || '',\n  lead: merged, save_lead, hot, time: new Date().toISOString().slice(0, 16).replace('T', ' ')}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
